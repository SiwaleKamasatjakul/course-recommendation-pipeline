    max(EVENT_TS_UTC)                                   as max_event_ts_utc,
    try_to_number(regexp_substr(COURSE_KEY, 'grade\\s*(\\d+)', 1, 1, 'e', 1)) as grade,
    from ABACUS_ANALYTICS.INTERMEDIATE.int_course_interactions
    group by course_key




)

select * from course_catalog
    )

