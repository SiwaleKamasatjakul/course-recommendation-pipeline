    SELECT *
    FROM ABACUS_ANALYTICS.RAW.clickstream_events
    WHERE EVENT_TYPE = 'course_card_clicked'
),

flattened AS (
    SELECT
        EVENT_TYPE                              AS event_type,
        SESSION_ID                              AS session_id,
