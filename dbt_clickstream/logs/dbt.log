create or replace transient  table ABACUS_ANALYTICS.INTERMEDIATE.int_course_catalog
    
    
    
    
    as (

with course_catalog as (
    
    select 
    COURSE_KEY                                          as course_key,
    COUNT(DISTINCT OFFERING_ID)                         as offering_count,
