create or replace transient  table ABACUS_ANALYTICS.INTERMEDIATE.int_course_popularity
    
    
    
    
    as (

with recent as (
    select * 
    from ABACUS_ANALYTICS.INTERMEDIATE.int_course_interactions
    where event_ts_utc >= dateadd('day', - 90, CURRENT_TIMESTAMP())
),



per_course as (
